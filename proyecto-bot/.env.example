# Copia este archivo como .env y llena los valores reales
# NUNCA subas el .env a GitHub — contiene credenciales

# Gmail que manda el reporte diario (crea uno nuevo solo para el bot)
GMAIL_USER=bot.officeschool@gmail.com

# Contraseña de APLICACIÓN de Gmail (no la contraseña normal)
# Cómo obtenerla: Google Account → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones
GMAIL_PASS=xxxx xxxx xxxx xxxx

# Correo de Sol donde llega el reporte cada día
SOL_EMAIL=sol@gmail.com

# Hora del reporte diario en formato 24h (20 = 8:00 PM hora CDMX)
HORA_REPORTE=20
